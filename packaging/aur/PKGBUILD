# Maintainer: Felipe Camus <felipe.camus.d at gmail dot com>
pkgname=clipbroad-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Share the clipboard between your own machines, peer-to-peer'
arch=('x86_64')
url='https://github.com/fcamus00/clipbroad'
license=('MIT OR Apache-2.0')
depends=('gcc-libs' 'glibc')
provides=('clipbroad')
conflicts=('clipbroad')
options=('!debug')
source=("https://github.com/fcamus00/clipbroad/releases/download/v$pkgver/clipbroad-v$pkgver-linux-x86_64.tar.gz")
sha256sums=('@SHA256@')

package() {
  cd "clipbroad-v$pkgver-linux-x86_64"
  install -Dm755 clipbroad -t "$pkgdir/usr/bin"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname"
}
